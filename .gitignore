.Rproj.user
.Rhistory
.RData
.Ruserdata

# Excel lock files
~$*.xlsx
# Word lock files
~$*.docx

# R analysis outputs (regenerated by the scripts; not version-controlled)
output/

# Source imagery for the figures (specimen photographs and the like): large,
# binary, and not needed to reproduce any result
asset/

# Spatial cache: ~51 MB of DEM-derived rasters, basemap tiles and vector layers.
# Rebuildable by paper/map/setup.R, which needs a network connection and
# WhiteboxTools. Only the Figure 1 map pipeline reads it; nothing in the
# manuscript or the supplementary material does.
data/cache/

# Python caches
__pycache__/
*.pyc

# Stray base-graphics device output (scripts regenerate it; never referenced)
Rplots.pdf

# The targets store: eleven cached Stan fits (~40 MB each) plus the analysis
# environment and the pipeline metadata. Rebuilt by tar_make(); this is the
# object that belongs in the OSF/Zenodo deposit, not in git.
_targets/
paper/barg/dummy_data.csv

# The hand-rolled fit cache targets replaced. Kept ignored so that an existing
# checkout does not suddenly start tracking 300 MB of superseded fits.
paper/barg/fits/
paper/barg/fits_quick/

# Scratch directory of exploratory analyses; nothing in the manuscript or the
# supplementary material reads it.
analysis/


# Agent files
.meta*
.open*/
.brain/
AGENTS.md

.Rproj.user

# Open ScholarPeer MCP runtime (venv + server, gitignored)
.open-scholar-peer/

# API keys (never commit)
.env

#  log files
*.log
